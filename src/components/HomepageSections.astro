---
import workspaceImage from '~/assets/images/borchani-workspace-concept.png';
import type { Translations } from '~/i18n/schema';

interface Props {
  t: Translations;
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const copy = {
  ru: {
    title: 'Создавайте веб-приложения с ИИ',
    subtitle: 'Опишите задачу, изучите файлы проекта и улучшайте результат в рабочем пространстве Borchani.',
    action: 'Открыть Borchani',
    workspace: 'От описания задачи к работающему приложению',
    note: 'Иллюстрация интерфейса Borchani.',
    founder: 'Основатель — Аманай Есен. Borchani основан 5 апреля 2026 года в Сан-Франциско, Калифорния.',
  },
  es: {
    title: 'Crea aplicaciones web con IA',
    subtitle:
      'Describe tu proyecto, inspecciona los archivos y mejora el resultado en el espacio de trabajo de Borchani.',
    action: 'Abrir Borchani',
    workspace: 'De la especificación a una aplicación funcional',
    note: 'Vista ilustrativa del espacio de trabajo de Borchani.',
    founder: 'Fundada por Amanay Yessen el 5 de abril de 2026 en San Francisco, California.',
  },
  ja: {
    title: 'AIでウェブアプリを構築',
    subtitle: 'プロジェクトを説明し、ファイルを確認しながら、Borchaniのワークスペースで改善できます。',
    action: 'Borchaniを開く',
    workspace: '仕様から動くアプリへ',
    note: 'Borchaniワークスペースのイメージ図です。',
    founder: '創業者はAmanay Yessen。2026年4月5日にカリフォルニア州サンフランシスコで設立。',
  },
  ko: {
    title: 'AI로 웹 앱 만들기',
    subtitle: '프로젝트를 설명하고 파일을 검토하며 Borchani 작업 공간에서 결과를 개선하세요.',
    action: 'Borchani 열기',
    workspace: '명세에서 작동하는 앱까지',
    note: 'Borchani 작업 공간을 설명하는 이미지입니다.',
    founder: '창업자 Amanay Yessen. 2026년 4월 5일 미국 캘리포니아주 샌프란시스코에서 설립되었습니다.',
  },
};
const c = copy[locale as keyof typeof copy] ?? copy.ru;
---

<section class="px-4 py-20 sm:py-28 not-prose">
  <div class="max-w-5xl mx-auto text-center">
    <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-default dark:text-white">{c.title}</h1>
    <p class="mt-6 text-lg sm:text-xl text-muted dark:text-slate-300 max-w-3xl mx-auto">{c.subtitle}</p>
    <a
      href="https://app.borchani.com/build"
      class="inline-flex mt-8 px-6 py-3 rounded-xl bg-primary text-white font-semibold hover:opacity-90">{c.action}</a
    >
  </div>
</section>
<section class="px-4 pb-20 not-prose">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl sm:text-4xl font-bold text-center mb-8 dark:text-white">{c.workspace}</h2>
    <figure class="overflow-hidden rounded-2xl border border-gray-200 dark:border-slate-700 shadow-xl">
      <img src={workspaceImage.src} width="1672" height="941" class="w-full h-auto" alt={c.note} />
      <figcaption class="px-4 py-3 text-sm text-muted dark:text-slate-400">{c.note}</figcaption>
    </figure>
    <p class="mt-10 text-center text-muted dark:text-slate-300">{c.founder}</p>
  </div>
</section>
