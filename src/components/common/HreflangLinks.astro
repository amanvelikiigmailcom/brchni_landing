---
import { SITE } from 'astrowind:config';

const { pathname } = Astro.url;
const base = SITE?.site ?? 'https://borchani.com';

// The homepage and privacy policy have full locale variants.
const homePaths = ['/', '/ru', '/ru/', '/ru.html'];
const isHomepage = homePaths.includes(pathname);
const privacyPaths = ['/privacy', '/privacy.html', '/ru/privacy', '/ru/privacy.html'];
const isPrivacy = privacyPaths.includes(pathname);
---

{isHomepage && (
  <>
    <link rel="alternate" hreflang="en" href={`${base}`} />
    <link rel="alternate" hreflang="ru" href={`${base}/ru`} />
    <link rel="alternate" hreflang="x-default" href={`${base}`} />
  </>
)}

{isPrivacy && (
  <>
    <link rel="alternate" hreflang="en" href={`${base}/privacy`} />
    <link rel="alternate" hreflang="ru" href={`${base}/ru/privacy`} />
    <link rel="alternate" hreflang="x-default" href={`${base}/privacy`} />
  </>
)}
