---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';

const founderUrl = 'https://www.linkedin.com/in/amanay-yessen-1a1a26188/?locale=en';
const githubUrl = 'https://github.com/amanvelikiigmailcom/brchni_landing';
const metadata = {
  title: 'About Borchani — AI Workspace for Web Applications',
  description:
    'Meet Borchani and founder Amanay Yessen. Learn why we are building an AI workspace for web application development.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="About Borchani"
    title="A clearer way to build with AI"
    subtitle="Borchani brings the request, project files, and application preview into one workspace so builders can move from an idea to a working web application."
  />

  <section class="px-4 py-12 sm:py-16 not-prose">
    <div class="max-w-4xl mx-auto grid gap-8 md:grid-cols-2">
      <div class="rounded-2xl border border-gray-200 dark:border-slate-700 p-7">
        <h2 class="text-2xl font-bold dark:text-white">What we are building</h2>
        <p class="mt-4 text-muted dark:text-slate-300">
          Starting a web application should not require switching between a blank editor, a chat window, and a preview.
          Borchani connects these steps: describe the project, inspect the generated code, and iterate on the result.
        </p>
        <p class="mt-4 text-muted dark:text-slate-300">
          The product is for developers, founders, and product teams who want a visible, editable path from a
          specification to a working application.
        </p>
      </div>
      <div class="rounded-2xl border border-gray-200 dark:border-slate-700 p-7">
        <h2 class="text-2xl font-bold dark:text-white">Founder and company</h2>
        <p class="mt-4 text-muted dark:text-slate-300">
          Borchani was founded by Amanay Yessen on April 5, 2026 in San Francisco, California. Today the product serves
          customers building real web applications.
        </p>
        <div class="mt-5 flex flex-col gap-3 font-medium text-primary">
          <a href={founderUrl} target="_blank" rel="noopener noreferrer" class="hover:underline"
            >Amanay Yessen on LinkedIn ↗</a
          >
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="hover:underline"
            >Borchani website repository on GitHub ↗</a
          >
          <a href="mailto:support@borchani.com" class="hover:underline">support@borchani.com</a>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 pb-20 not-prose">
    <div class="max-w-4xl mx-auto rounded-2xl bg-blue-50 dark:bg-slate-900 p-8 text-center">
      <h2 class="text-2xl font-bold dark:text-white">See the workspace for yourself</h2>
      <p class="mt-3 text-muted dark:text-slate-300">Start with a description of the application you want to build.</p>
      <a
        href="https://app.borchani.com/build"
        class="inline-flex mt-6 px-6 py-3 rounded-xl bg-primary text-white font-semibold hover:opacity-90"
        >Open Borchani</a
      >
    </div>
  </section>
</Layout>
