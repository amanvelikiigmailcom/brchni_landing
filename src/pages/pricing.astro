---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Pricing — Borchani AI App Builder Plans',
  description:
    'Simple pricing for every stage. Start free, upgrade when you need more. No contracts, no hidden fees — just build and ship faster with AI.',
  openGraph: {
    type: 'website',
  },
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Pricing"
    title="Pay for what you use. Nothing else."
    subtitle="We kept the pricing simple on purpose. Pick the plan that fits where you are right now — you can always change it later."
  />

  <!-- Pricing Widget ******************* -->

  <Prices
    title="Pick your plan"
    subtitle="All plans include the core Borchani experience. Paid plans just remove the limits."
    columns={4}
    prices={[
      {
        title: 'Free',
        subtitle: 'Try it, no card required',
        price: 0,
        period: 'forever',
        items: [
          { description: '5 credits / day' },
          { description: 'Public projects only' },
          { description: 'Community support' },
        ],
        callToAction: {
          target: '_blank',
          text: 'Start for free',
          href: 'https://app.borchani.com/signup',
        },
      },
      {
        title: 'Pro',
        subtitle: 'For solo builders moving fast',
        price: 19,
        period: 'per month',
        items: [
          { description: '100 credits / month' },
          { description: '5 daily credits (up to 150/mo)' },
          { description: 'Credit rollovers' },
          { description: 'On-demand credit top-ups' },
          { description: 'Custom domains' },
          { description: 'User roles & permissions' },
        ],
        callToAction: {
          target: '_blank',
          text: 'Get Pro',
          href: 'https://app.borchani.com/signup?plan=pro',
        },
        hasRibbon: true,
        ribbonTitle: 'Most popular',
      },
      {
        title: 'Business',
        subtitle: 'For teams shipping together',
        price: 49,
        period: 'per month',
        items: [
          { description: '350 credits / month' },
          { description: 'Everything in Pro' },
          { description: 'Internal publish' },
          { description: 'Team workspace' },
          { description: 'Personal projects' },
          { description: 'Design templates' },
          { description: 'Role-based access' },
          { description: 'Security center' },
        ],
        callToAction: {
          target: '_blank',
          text: 'Get Business',
          href: 'https://app.borchani.com/signup?plan=business',
        },
      },
      {
        title: 'Premium',
        subtitle: 'For power users & agencies',
        price: 199,
        period: 'per month',
        items: [
          { description: '1,700 credits / month' },
          { description: 'Everything in Business' },
          { description: 'Volume-based credit pricing' },
          { description: 'Dedicated support' },
        ],
        callToAction: {
          target: '_blank',
          text: 'Get Premium',
          href: 'https://app.borchani.com/signup?plan=premium',
        },
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="What every plan comes with"
    subtitle="A few things that are true no matter which tier you're on"
    columns={2}
    items={[
      {
        title: 'Transparent pricing',
        description:
          'The price you see is the price you pay. No surprise charges at the end of the month, ever.',
        icon: 'tabler:flip-vertical',
      },
      {
        title: 'You own the code',
        description:
          'Every line of code Borchani generates belongs to you. Export it, modify it, deploy it anywhere.',
        icon: 'tabler:code',
      },
      {
        title: 'Secure payments',
        description:
          'Payments processed through Stripe. We never store card data on our servers.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Instant access',
        description:
          'Once you subscribe, you get access immediately — no waiting period, no manual activation.',
        icon: 'tabler:bolt',
      },
      {
        title: 'Upgrade or downgrade anytime',
        description:
          'Plans are billed monthly. Switch up or down whenever your needs change, no penalties.',
        icon: 'tabler:arrows-exchange',
      },
      {
        title: 'Support on every plan',
        description:
          'Community support on Free, email support on Pro, priority chat + email on Team.',
        icon: 'tabler:headset',
      },
    ]}
    classes={{ container: 'max-w-5xl' }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="Up and running in minutes"
    tagline="How it works"
    isReversed={true}
    items={[
      {
        title: 'Pick your plan',
        icon: 'tabler:number-1',
      },
      {
        title: 'Create your account',
        icon: 'tabler:number-2',
      },
      {
        title: 'Enter payment details',
        icon: 'tabler:number-3',
      },
      {
        title: 'Confirm your subscription',
        icon: 'tabler:number-4',
      },
      {
        title: 'Open the builder',
        icon: 'tabler:number-5',
      },
      {
        title: 'Describe your app and hit build',
        icon: 'tabler:number-6',
      },
      {
        title: 'Ship it',
        icon: 'tabler:number-7',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1522542550221-31fd19575a2d?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'Getting started with Borchani',
    }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Pricing questions"
    subtitle="If something still isn't clear after reading this, reach out — we'll reply the same day."
    columns={1}
    items={[
      {
        title: 'Does the free plan expire?',
        description:
          'No. The free plan is free forever. You get 5 credits per day — no credit card required to start.',
      },
      {
        title: 'What is a credit?',
        description:
          'One credit = one AI generation or edit. Simple prompts use 1 credit; complex generations use more. You can see the exact cost before confirming any action.',
      },
      {
        title: 'What are credit rollovers?',
        description:
          'On Pro and above, unused monthly credits carry over to the next month instead of disappearing. Your balance grows if you have a lighter month.',
      },
      {
        title: 'Can I buy extra credits without upgrading?',
        description:
          'Yes. Pro and above plans include on-demand credit top-ups — buy a block of credits whenever you need them without changing your plan.',
      },
      {
        title: 'Can I cancel at any time?',
        description:
          'Yes. Cancel from your account settings anytime. You keep access until the end of the billing period and you will not be charged again.',
      },
      {
        title: 'What happens to my projects if I downgrade?',
        description:
          'Your projects stay intact. You lose access to paid features (custom domains, team workspace, etc.) but all your code and history remain yours.',
      },
      {
        title: 'Do you offer annual billing?',
        description:
          'Yes — annual plans save 20%. Switch to annual billing from your account settings at any time.',
      },
      {
        title: 'Are there any hidden fees?',
        description:
          'None. The monthly price covers everything listed in the plan.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Ready to build something?"
    subtitle="Start on the free plan today — no card required. Upgrade whenever it makes sense for you."
    actions={[
      {
        variant: 'primary',
        text: 'Start building free',
        href: 'https://app.borchani.com/signup',
        target: '_blank',
      },
    ]}
  />

  <!-- JSON-LD: BreadcrumbList -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://borchani.com" },
      { "@type": "ListItem", "position": 2, "name": "Pricing", "item": "https://borchani.com/pricing" }
    ]
  })} />

  <!-- JSON-LD: PriceSpecification -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Borchani", "applicationCategory": "DeveloperApplication", "operatingSystem": "All",
    "url": "https://borchani.com",
    "offers": [
      {
        "@type": "Offer",
        "name": "Free",
        "description": "5 credits per day, public projects, community support",
        "price": "0",
        "priceCurrency": "USD",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "0",
          "priceCurrency": "USD",
          "unitText": "MONTH"
        }
      },
      {
        "@type": "Offer",
        "name": "Pro",
        "description": "100 credits/month, credit rollovers, custom domains, user roles",
        "price": "19",
        "priceCurrency": "USD",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "19",
          "priceCurrency": "USD",
          "unitText": "MONTH"
        }
      },
      {
        "@type": "Offer",
        "name": "Business",
        "description": "350 credits/month, team workspace, role-based access, security center",
        "price": "49",
        "priceCurrency": "USD",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "49",
          "priceCurrency": "USD",
          "unitText": "MONTH"
        }
      },
      {
        "@type": "Offer",
        "name": "Premium",
        "description": "1700 credits/month, volume-based pricing, dedicated support",
        "price": "199",
        "priceCurrency": "USD",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "199",
          "priceCurrency": "USD",
          "unitText": "MONTH"
        }
      }
    ]
  })} />
</Layout>
