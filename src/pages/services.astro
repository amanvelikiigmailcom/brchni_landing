---
import workspaceImage from '~/assets/images/borchani-workspace-concept.png';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'What You Can Build with Borchani',
  description: 'Use Borchani to explore web application ideas, inspect generated code, and iterate in a live preview.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Use cases"
    title="From a clear request to a web application"
    subtitle="Borchani helps you describe an application, review the project, and refine the result in one workspace."
  />
  <Features2
    title="Ideas to explore"
    subtitle="Use the workspace to build and iterate on the web tools you need."
    columns={3}
    items={[
      {
        title: 'Product prototypes',
        description: 'Turn a product specification into an application you can review and improve.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Internal tools',
        description: 'Explore dashboards, forms, approval flows, and other interfaces for your team.',
        icon: 'tabler:tool',
      },
      {
        title: 'Customer portals',
        description: 'Create and refine client-facing screens, account views, and project workspaces.',
        icon: 'tabler:layout-dashboard',
      },
      {
        title: 'Data interfaces',
        description: 'Try charts, tables, filters, and layouts around a data-driven workflow.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Landing pages',
        description: 'Build a responsive web presence and inspect its structure as you iterate.',
        icon: 'tabler:layout',
      },
      {
        title: 'Team experiments',
        description: 'Test ideas together before committing to a larger build.',
        icon: 'tabler:users',
      },
    ]}
  />
  <section class="px-4 pb-16 not-prose">
    <div class="max-w-6xl mx-auto rounded-2xl border border-gray-200 dark:border-slate-700 overflow-hidden">
      <img
        src={workspaceImage.src}
        width="1672"
        height="941"
        loading="lazy"
        class="w-full h-auto"
        alt="Illustrative interface of the Borchani workspace, showing instructions, code, and a live preview"
      />
      <p class="px-4 py-3 text-sm text-muted dark:text-slate-400">Illustrative view of the workspace.</p>
    </div>
  </section>
  <CallToAction
    title="Build your next web application"
    subtitle="Open Borchani and describe what you want to make."
    actions={[{ variant: 'primary', text: 'Open Borchani', href: 'https://app.borchani.com/build', target: '_blank' }]}
  />
</Layout>
