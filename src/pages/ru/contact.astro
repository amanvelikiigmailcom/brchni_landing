---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Контакты - Borchani',
  description:
    'Вопросы об аккаунте, оплате или корпоративном плане? Напишите нам - отвечаем в течение одного рабочего дня.',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Контакты" title="Мы живые люди. Просто спросите." />

  <section class="px-4 pb-12 not-prose">
    <div class="max-w-2xl mx-auto rounded-2xl border border-gray-200 dark:border-slate-700 p-8 text-center">
      <h2 class="text-2xl font-bold dark:text-white">Напишите нам</h2>
      <p class="mt-3 text-muted dark:text-slate-300">
        По вопросам продукта, аккаунта и оплаты пишите на корпоративную почту Borchani.
      </p>
      <a
        href="mailto:support@borchani.com"
        class="inline-flex mt-6 px-6 py-3 rounded-xl bg-primary text-white font-semibold hover:opacity-90"
        >support@borchani.com</a
      >
    </div>
  </section>

  <Features2
    title="Другие способы связи"
    items={[
      {
        title: 'Общие вопросы',
        description:
          'Доступ к аккаунту, оплата, смена плана или любые другие вопросы об использовании Borchani - напишите по email или используйте форму выше.',
      },
      {
        title: 'Корпоративные запросы',
        description: 'Обсудить внедрение Borchani для продуктовой команды можно по email.',
      },
      {
        title: 'Технические проблемы',
        description:
          'Если сборка падает, что-то выглядит сломанным или в сгенерированном коде есть постоянная ошибка - опишите здесь, и мы разберёмся.',
      },
      {
        title: 'Discord-сообщество',
        description: 'LinkedIn основателя: Amanay Yessen',
        icon: 'tabler:brand-discord',
      },
      {
        title: 'Email',
        description: 'support@borchani.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Базируемся в',
        description: 'Сан-Франциско, Калифорния',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
