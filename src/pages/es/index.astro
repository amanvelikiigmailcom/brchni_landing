---
import PageLayout from '~/layouts/PageLayout.astro';
import HomepageSections from '~/components/HomepageSections.astro';
import { useTranslations } from '~/i18n';

const locale = 'es';
const t = useTranslations(locale);

const metadata = {
  title: 'Borchani — AI Workspace for Web Applications',
  description: 'Build and refine web applications in the Borchani workspace.',
  ignoreTitleTemplate: true,
};
---

<PageLayout metadata={metadata}>
  <HomepageSections t={t} locale={locale} />
</PageLayout>
