---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';

const metadata = {
  title: 'Build Ideas — Borchani',
  description: 'Explore web application ideas you can develop in the Borchani workspace.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Build ideas"
    title="What could you build?"
    subtitle="These are example project briefs to try in Borchani, not customer case studies."
  />
  <section class="px-4 pb-20 not-prose">
    <div class="max-w-6xl mx-auto grid gap-6 md:grid-cols-3">
      {
        [
          {
            title: 'Project dashboard',
            text: 'A dashboard with project status, team activity, and filters for recent work.',
          },
          {
            title: 'Booking application',
            text: 'A responsive scheduling flow with available times, customer details, and confirmations.',
          },
          {
            title: 'Customer portal',
            text: 'An account area where customers can view requests, updates, and shared documents.',
          },
        ].map((idea) => (
          <article class="rounded-2xl border border-gray-200 dark:border-slate-700 p-7">
            <h2 class="text-xl font-bold dark:text-white">{idea.title}</h2>
            <p class="mt-3 text-muted dark:text-slate-300">{idea.text}</p>
          </article>
        ))
      }
    </div>
    <div class="max-w-6xl mx-auto mt-10 text-center">
      <a
        href="https://app.borchani.com/build"
        class="inline-flex px-6 py-3 rounded-xl bg-primary text-white font-semibold hover:opacity-90">Open Borchani</a
      >
    </div>
  </section>
</Layout>
