---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';

const metadata = {
  title: 'Contact Borchani',
  description: 'Contact the Borchani team about product, account, or billing questions.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Contact"
    title="Get in touch with Borchani"
    subtitle="Questions about the workspace, your account, or billing? Email the team directly."
  />
  <section class="px-4 pb-20 not-prose">
    <div class="max-w-2xl mx-auto rounded-2xl border border-gray-200 dark:border-slate-700 p-8 text-center">
      <h2 class="text-2xl font-bold dark:text-white">Email support</h2>
      <p class="mt-3 text-muted dark:text-slate-300">
        Send your question to our domain email address. Include your account email if you need help with an existing
        subscription.
      </p>
      <a
        href="mailto:support@borchani.com"
        class="inline-flex mt-6 px-6 py-3 rounded-xl bg-primary text-white font-semibold hover:opacity-90"
        >support@borchani.com</a
      >
    </div>
  </section>
</Layout>
