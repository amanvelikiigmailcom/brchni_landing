---
import workspaceImage from '~/assets/images/borchani-workspace-concept.png';
import PageLayout from '~/layouts/PageLayout.astro';
import PromptHero from '~/components/widgets/PromptHero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const siteUrl = 'https://borchani.com/';
const founderUrl = 'https://www.linkedin.com/in/amanay-yessen-1a1a26188/?locale=en';
const githubUrl = 'https://github.com/amanvelikiigmailcom/brchni_landing';
const description =
  'Borchani is an AI workspace for building and iterating on web applications. Describe a project, inspect the generated code, and test it in a live preview.';
const metadata = {
  title: 'Borchani — AI Workspace for Building Web Applications',
  description,
  ignoreTitleTemplate: true,
  canonical: siteUrl,
  openGraph: {
    title: 'Borchani — Build Web Applications with AI',
    description,
    url: siteUrl,
    type: 'website',
    images: [{ url: '~/assets/images/borchani-workspace-concept.png', width: 1672, height: 941 }],
  },
};

const faqs = [
  {
    title: 'What is Borchani?',
    description:
      'Borchani is an AI workspace for creating and refining web applications from natural-language instructions. You can review the project and see the result in a live preview.',
    icon: 'tabler:chevrons-right',
  },
  {
    title: 'Who is Borchani for?',
    description:
      'Developers, founders, and product teams use Borchani to explore ideas, build interfaces, and iterate on applications.',
    icon: 'tabler:chevrons-right',
  },
  {
    title: 'Can I review the code?',
    description:
      'Yes. Borchani is designed around a visible project workspace, so you can inspect the files as you refine your app.',
    icon: 'tabler:chevrons-right',
  },
  {
    title: 'How do I get started?',
    description:
      'Open the Borchani app, describe the web application you want to build, and continue refining it in the workspace.',
    icon: 'tabler:chevrons-right',
  },
];
---

<PageLayout metadata={metadata}>
  <PromptHero />

  <section id="workspace" class="px-4 py-16 sm:py-20 not-prose" aria-labelledby="workspace-title">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-primary font-semibold mb-3">Inside the workspace</p>
        <h2 id="workspace-title" class="text-3xl sm:text-4xl font-bold tracking-tight text-default dark:text-white">
          From a specification to a working app
        </h2>
        <p class="mt-4 text-lg text-muted dark:text-slate-400 max-w-3xl mx-auto">
          Describe what you want to build, inspect the project files, and refine the result in a live preview.
        </p>
      </div>
      <figure
        class="overflow-hidden rounded-2xl border border-gray-200 dark:border-slate-700 shadow-xl bg-white dark:bg-slate-900"
      >
        <img
          src={workspaceImage.src}
          width="1672"
          height="941"
          loading="eager"
          decoding="async"
          class="w-full h-auto"
          alt="Illustrative Borchani workspace interface with a task panel, project files and code editor, and live application preview"
        />
        <figcaption
          class="px-4 py-3 text-sm text-muted dark:text-slate-400 border-t border-gray-200 dark:border-slate-700"
        >
          Illustrative view of the Borchani workspace.
        </figcaption>
      </figure>
    </div>
  </section>

  <Features
    id="features"
    tagline="Why Borchani"
    title="Build in one connected workspace"
    subtitle="Keep the request, project files, and running result together while you iterate."
    columns={3}
    items={[
      {
        title: 'Start with a specification',
        description:
          'Explain the application you need in plain language and use it as the starting point for the project.',
        icon: 'tabler:file-text',
      },
      {
        title: 'Inspect the project',
        description: 'See the generated files and code rather than treating the result as a black box.',
        icon: 'tabler:files',
      },
      {
        title: 'Preview the result',
        description: 'Check the application visually as you work and use what you see to guide the next change.',
        icon: 'tabler:device-laptop',
      },
      {
        title: 'Iterate through instructions',
        description: 'Ask for changes in the same workspace and refine the application step by step.',
        icon: 'tabler:messages',
      },
      {
        title: 'Build for real use cases',
        description: 'Explore dashboards, internal tools, product prototypes, and other web application ideas.',
        icon: 'tabler:layout-dashboard',
      },
      {
        title: 'Keep developers in control',
        description: 'Review the implementation and decide what to change before sharing your work.',
        icon: 'tabler:code',
      },
    ]}
  />

  <Steps
    id="how-it-works"
    tagline="How it works"
    title="A direct path from idea to iteration"
    items={[
      {
        title: '1. Describe the project',
        description: 'Write a short specification of the app, its users, and the screens or behavior you need.',
        icon: 'tabler:pencil',
      },
      {
        title: '2. Inspect and test',
        description: 'Review the project files and explore the application in the preview.',
        icon: 'tabler:eye',
      },
      {
        title: '3. Refine it',
        description: 'Give follow-up instructions, check the result, and repeat until the project fits your goal.',
        icon: 'tabler:adjustments',
      },
    ]}
  />

  <Testimonials
    title="What builders say"
    subtitle="Feedback from people building with Borchani."
    testimonials={[
      {
        testimonial:
          'I launched my SaaS MVP in a weekend. No backend experience, no DevOps. Borchani just handled everything.',
        name: 'Marco R.',
        job: 'Founder, Trackflow',
      },
      {
        testimonial:
          'We replaced a 3-week sprint with a 2-hour Borchani session. The code quality was good enough to ship straight to production.',
        name: 'Aiko T.',
        job: 'Engineering Lead, Stackline',
      },
      {
        testimonial:
          'Borchani is the first vibe coding tool where the output is actually maintainable TypeScript. Our devs were happy to take it over.',
        name: 'Daniel K.',
        job: 'CTO, Novu Labs',
      },
    ]}
  />

  <section class="px-4 py-16 sm:py-20 not-prose" aria-labelledby="founder-title">
    <div
      class="max-w-4xl mx-auto rounded-2xl border border-gray-200 dark:border-slate-700 bg-blue-50 dark:bg-slate-900 p-8 sm:p-10"
    >
      <p class="text-primary font-semibold mb-3">Founder</p>
      <h2 id="founder-title" class="text-2xl sm:text-3xl font-bold text-default dark:text-white">
        Built by Amanay Yessen
      </h2>
      <p class="mt-3 text-muted dark:text-slate-300">
        Borchani was founded on April 5, 2026 in San Francisco, California. We build tools that help developers and
        product teams turn application ideas into working software.
      </p>
      <div class="mt-5 flex flex-wrap gap-5 text-primary font-medium">
        <a href={founderUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">Amanay on LinkedIn ↗</a>
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="hover:underline"
          >Borchani website on GitHub ↗</a
        >
      </div>
    </div>
  </section>

  <FAQs id="faq" title="Frequently asked questions" items={faqs} />
  <BlogLatestPosts
    id="blog"
    title="Guides and product notes"
    information="Explore articles about building web applications and working with Borchani."
  />
  <CallToAction
    title="Start building with Borchani"
    subtitle="Open the workspace and describe the app you want to create."
    actions={[{ variant: 'primary', text: 'Open Borchani', href: 'https://app.borchani.com/build', target: '_blank' }]}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Person',
          '@id': `${siteUrl}#founder`,
          name: 'Amanay Yessen',
          url: founderUrl,
          sameAs: [founderUrl],
        },
        {
          '@type': 'Organization',
          '@id': `${siteUrl}#organization`,
          name: 'Borchani',
          url: siteUrl,
          foundingDate: '2026-04-05',
          founder: { '@id': `${siteUrl}#founder` },
          sameAs: [githubUrl],
          contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: 'support@borchani.com' },
        },
        {
          '@type': 'WebSite',
          '@id': `${siteUrl}#website`,
          name: 'Borchani',
          url: siteUrl,
          publisher: { '@id': `${siteUrl}#organization` },
        },
        {
          '@type': 'WebPage',
          '@id': `${siteUrl}#webpage`,
          name: metadata.title,
          url: siteUrl,
          description,
          isPartOf: { '@id': `${siteUrl}#website` },
          about: { '@id': `${siteUrl}#organization` },
          author: { '@id': `${siteUrl}#founder` },
        },
        {
          '@type': 'SoftwareApplication',
          '@id': `${siteUrl}#application`,
          name: 'Borchani',
          url: 'https://app.borchani.com/',
          applicationCategory: 'DeveloperApplication',
          publisher: { '@id': `${siteUrl}#organization` },
          review: [
            {
              '@type': 'Review',
              author: { '@type': 'Person', name: 'Marco R.' },
              reviewBody:
                'I launched my SaaS MVP in a weekend. No backend experience, no DevOps. Borchani just handled everything.',
            },
            {
              '@type': 'Review',
              author: { '@type': 'Person', name: 'Aiko T.' },
              reviewBody:
                'We replaced a 3-week sprint with a 2-hour Borchani session. The code quality was good enough to ship straight to production.',
            },
            {
              '@type': 'Review',
              author: { '@type': 'Person', name: 'Daniel K.' },
              reviewBody:
                'Borchani is the first vibe coding tool where the output is actually maintainable TypeScript. Our devs were happy to take it over.',
            },
          ],
        },
      ],
    })}
  />
</PageLayout>
