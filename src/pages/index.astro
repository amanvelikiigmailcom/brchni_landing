---
import workspaceImage from '~/assets/images/borchani-workspace-concept.png';
import PageLayout from '~/layouts/PageLayout.astro';
import PromptHero from '~/components/widgets/PromptHero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps from '~/components/widgets/Steps.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const siteUrl = 'https://borchani.com/';
const founderUrl = 'https://www.linkedin.com/in/amanay-yessen-1a1a26188/?locale=en';
const githubUrl = 'https://github.com/amanvelikiigmailcom/brchni_landing';
const description =
  'Spec-driven software engineering workspace. Build, test, and deploy full-stack applications using autonomous code agents and instant sandbox execution.';
const metadata = {
  title: 'Borchani — AI-Native Full-Stack Workspace',
  description,
  ignoreTitleTemplate: true,
  canonical: siteUrl,
  openGraph: {
    title: 'Borchani — AI-Native Full-Stack Workspace',
    description,
    url: siteUrl,
    type: 'website',
    images: [{ url: '~/assets/images/borchani-workspace-concept.png', width: 1672, height: 941 }],
  },
};

const faqs = [
  {
    title: 'What is Borchani?',
    description:
      'Borchani is an AI-native software engineering and full-stack workspace for developers and product teams. Start with a specification, inspect project files and test in a live preview.',
    icon: 'tabler:chevrons-right',
  },
  {
    title: 'Who is Borchani for?',
    description:
      'Developers, founders and product teams use Borchani to scaffold and refine full-stack web applications.',
    icon: 'tabler:chevrons-right',
  },
  {
    title: 'Can I review the code?',
    description:
      'Yes. Borchani is designed around a visible project workspace, so you can inspect the files as you refine your app.',
    icon: 'tabler:chevrons-right',
  },
  {
    title: 'How do I get started?',
    description:
      'Open the Borchani app, describe the web application you want to build, and continue refining it in the workspace.',
    icon: 'tabler:chevrons-right',
  },
];
---

<PageLayout metadata={metadata}>
  <PromptHero />

  <Stats
    stats={[
      { amount: '4.9/5', title: 'Customer rating' },
      { amount: '127', title: 'Customer reviews' },
      { amount: 'Full-stack', title: 'Application workspace' },
      { amount: 'Live', title: 'Project preview' },
    ]}
  />

  <section class="px-4 py-16 sm:py-20 not-prose">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-default dark:text-white">
          Software projects span more than one file
        </h2>
        <p class="mt-4 text-lg text-muted dark:text-slate-400 max-w-2xl mx-auto">
          Borchani keeps the specification, code and running application in one developer workspace.
        </p>
      </div>
      <div class="grid sm:grid-cols-3 gap-8 text-center">
        <div class="rounded-2xl border border-red-100 dark:border-red-900/30 bg-red-50/50 dark:bg-red-950/20 p-8">
          <p class="text-5xl font-extrabold text-red-500 mb-3">01</p>
          <p class="text-lg font-semibold mb-2 text-default dark:text-white">Specify the application</p>
          <p class="text-muted dark:text-slate-400 text-sm leading-relaxed">
            Describe screens, data and behavior in natural language before you build.
          </p>
        </div>
        <div class="rounded-2xl border border-red-100 dark:border-red-900/30 bg-red-50/50 dark:bg-red-950/20 p-8">
          <p class="text-5xl font-extrabold text-red-500 mb-3">02</p>
          <p class="text-lg font-semibold mb-2 text-default dark:text-white">Inspect the codebase</p>
          <p class="text-muted dark:text-slate-400 text-sm leading-relaxed">
            Follow changes across files, components and routes in a visible project workspace.
          </p>
        </div>
        <div class="rounded-2xl border border-red-100 dark:border-red-900/30 bg-red-50/50 dark:bg-red-950/20 p-8">
          <p class="text-5xl font-extrabold text-red-500 mb-3">03</p>
          <p class="text-lg font-semibold mb-2 text-default dark:text-white">Test and refine</p>
          <p class="text-muted dark:text-slate-400 text-sm leading-relaxed">
            Use the live preview to evaluate the result and guide the next iteration.
          </p>
        </div>
      </div>
      <p class="text-center mt-12 text-xl font-semibold text-primary dark:text-blue-400">
        From specification to running software, in one place.
      </p>
    </div>
  </section>

  <section id="workspace" class="px-4 py-16 sm:py-20 not-prose" aria-labelledby="workspace-title">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-primary font-semibold mb-3">Inside the workspace</p>
        <h2 id="workspace-title" class="text-3xl sm:text-4xl font-bold tracking-tight text-default dark:text-white">
          From a specification to a working app
        </h2>
        <p class="mt-4 text-lg text-muted dark:text-slate-400 max-w-3xl mx-auto">
          Describe what you want to build, inspect the project files, and refine the result in a live preview.
        </p>
      </div>
      <figure
        class="overflow-hidden rounded-2xl border border-gray-200 dark:border-slate-700 shadow-xl bg-white dark:bg-slate-900"
      >
        <img
          src={workspaceImage.src}
          width="1672"
          height="941"
          loading="eager"
          decoding="async"
          class="w-full h-auto"
          alt="Illustrative Borchani workspace interface with a task panel, project files and code editor, and live application preview"
        />
        <figcaption
          class="px-4 py-3 text-sm text-muted dark:text-slate-400 border-t border-gray-200 dark:border-slate-700"
        >
          Illustrative view of the Borchani workspace.
        </figcaption>
      </figure>
    </div>
  </section>

  <Features
    id="features"
    tagline="Why Borchani"
    title="AI-native software engineering, from spec to preview"
    subtitle="Work across application files while keeping the specification and live result in view."
    columns={3}
    items={[
      {
        title: 'Multi-File Architecture Scaffolding',
        description: 'Generate consistent codebases, database schemas, and routing from a single spec.',
        icon: 'tabler:file-code',
      },
      {
        title: 'Instant Browser/Node Sandbox',
        description: 'Run your code in an isolated execution environment with hot reloading.',
        icon: 'tabler:box',
      },
      {
        title: 'Automated Self-Healing & Debugging',
        description: 'Autonomous compilation error analysis and automatic patch application.',
        icon: 'tabler:tool',
      },
      {
        title: 'Native GitHub & CI/CD Sync',
        description: 'Instant repository exports, branch creation, and PR generation.',
        icon: 'tabler:brand-github',
      },
      {
        title: 'Full-Stack Stack Support',
        description: 'First-class support for Next.js, React, Node.js, Tailwind CSS, and PostgreSQL.',
        icon: 'tabler:stack-2',
      },
      {
        title: 'Spec-Driven Iteration',
        description: 'Maintain the single source of truth in natural language to drive all future updates.',
        icon: 'tabler:file-text',
      },
    ]}
  />

  <Features2
    tagline="Built for product teams"
    title="A workspace for the people shipping software"
    subtitle="Borchani supports the path from initial requirements to a working web application."
    items={[
      {
        title: 'For developers',
        description: 'Inspect generated code, iterate on components and validate behavior in a live preview.',
        icon: 'tabler:code',
      },
      {
        title: 'For founders',
        description: 'Turn a product specification into a working prototype and refine it with your team.',
        icon: 'tabler:rocket',
      },
      {
        title: 'For product teams',
        description: 'Keep requirements, implementation and visual feedback in one shared workflow.',
        icon: 'tabler:users',
      },
    ]}
  >
    <Fragment slot="bg"><div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div></Fragment>
  </Features2>

  <Steps
    id="how-it-works"
    tagline="How it works"
    title="A direct path from idea to iteration"
    items={[
      {
        title: '1. Describe the project',
        description: 'Write a short specification of the app, its users, and the screens or behavior you need.',
        icon: 'tabler:pencil',
      },
      {
        title: '2. Inspect and test',
        description: 'Review the project files and explore the application in the preview.',
        icon: 'tabler:eye',
      },
      {
        title: '3. Refine it',
        description: 'Give follow-up instructions, check the result, and repeat until the project fits your goal.',
        icon: 'tabler:adjustments',
      },
    ]}
  />

  <Testimonials
    title="What builders say about Borchani"
    subtitle="Rated 4.9 out of 5 from 127 customer reviews."
    testimonials={[
      {
        testimonial:
          'I launched my SaaS MVP in a weekend. No backend experience, no DevOps. Borchani just handled everything.',
        name: 'Marco R.',
        job: 'Founder, Trackflow',
      },
      {
        testimonial:
          'We replaced a 3-week sprint with a 2-hour Borchani session. The code quality was good enough to ship straight to production.',
        name: 'Aiko T.',
        job: 'Engineering Lead, Stackline',
      },
      {
        testimonial:
          'Borchani is the first vibe coding tool where the output is actually maintainable TypeScript. Our devs were happy to take it over.',
        name: 'Daniel K.',
        job: 'CTO, Novu Labs',
      },
    ]}
  >
    <Fragment slot="bg"><div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div></Fragment>
  </Testimonials>
  <section class="px-4 py-16 sm:py-20 not-prose" aria-labelledby="founder-title">
    <div
      class="max-w-4xl mx-auto rounded-2xl border border-gray-200 dark:border-slate-700 bg-blue-50 dark:bg-slate-900 p-8 sm:p-10"
    >
      <p class="text-primary font-semibold mb-3">Founder</p>
      <h2 id="founder-title" class="text-2xl sm:text-3xl font-bold text-default dark:text-white">
        Built by Amanay Yessen — Software Engineer & Startup Founder
      </h2>
      <p class="mt-3 text-muted dark:text-slate-300">
        Borchani was founded on April 5, 2026 as a remote-first company. We build tools that help developers and product
        teams turn application ideas into working software.
      </p>
      <div class="mt-5 flex flex-wrap gap-5 text-primary font-medium">
        <a href="mailto:support@borchani.com" class="hover:underline flex items-center gap-1">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-mail"
            ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
              d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"></path><path
              d="M3 7l9 6l9 -6"></path></svg
          >
          support@borchani.com
        </a>
        <a href={founderUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">Amanay on LinkedIn ↗</a>
        <a href="https://x.com/amanvelikii" target="_blank" rel="noopener noreferrer" class="hover:underline"
          >X (Twitter) ↗</a
        >
        <a href="https://instagram.com/yessen_aman" target="_blank" rel="noopener noreferrer" class="hover:underline"
          >Instagram ↗</a
        >
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="hover:underline"
          >Borchani website on GitHub ↗</a
        >
      </div>
    </div>
  </section>

  <FAQs id="faq" title="Frequently asked questions" items={faqs} />
  <BlogLatestPosts
    id="blog"
    title="Guides and product notes"
    information="Explore articles about building web applications and working with Borchani."
  />
  <CallToAction
    title="Start building with Borchani"
    subtitle="Open the workspace and describe the app you want to create.<br><br>Need help or have questions? Email us at <a href='mailto:support@borchani.com' class='text-primary hover:underline'>support@borchani.com</a>."
    actions={[{ variant: 'primary', text: 'Open Borchani', href: 'https://app.borchani.com/build', target: '_blank' }]}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Person',
          '@id': `${siteUrl}#founder`,
          name: 'Amanay Yessen',
          url: founderUrl,
          sameAs: [founderUrl, 'https://x.com/amanvelikii', 'https://instagram.com/yessen_aman'],
        },
        {
          '@type': 'Organization',
          '@id': `${siteUrl}#organization`,
          name: 'Borchani',
          url: siteUrl,
          logo: `${siteUrl}favicon.ico`,
          foundingDate: '2026-04-05',
          founder: { '@id': `${siteUrl}#founder` },
          sameAs: [githubUrl],
          contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: 'support@borchani.com' },
        },
        {
          '@type': 'WebSite',
          '@id': `${siteUrl}#website`,
          name: 'Borchani',
          url: siteUrl,
          publisher: { '@id': `${siteUrl}#organization` },
        },
        {
          '@type': 'WebPage',
          '@id': `${siteUrl}#webpage`,
          name: metadata.title,
          url: siteUrl,
          description,
          isPartOf: { '@id': `${siteUrl}#website` },
          about: { '@id': `${siteUrl}#organization` },
          author: { '@id': `${siteUrl}#founder` },
        },
        {
          '@type': 'SoftwareApplication',
          '@id': `${siteUrl}#application`,
          name: 'Borchani',
          url: 'https://app.borchani.com/',
          applicationCategory: 'DeveloperApplication',
          operatingSystem: 'All',
          offers: {
            '@type': 'Offer',
            price: '0',
            priceCurrency: 'USD',
          },
          publisher: { '@id': `${siteUrl}#organization` },
          aggregateRating: {
            '@type': 'AggregateRating',
            ratingValue: '4.9',
            bestRating: '5',
            ratingCount: 127,
            reviewCount: 127,
          },
          review: [
            {
              '@type': 'Review',
              author: { '@type': 'Person', name: 'Marco R.' },
              reviewBody:
                'I launched my SaaS MVP in a weekend. No backend experience, no DevOps. Borchani just handled everything.',
            },
            {
              '@type': 'Review',
              author: { '@type': 'Person', name: 'Aiko T.' },
              reviewBody:
                'We replaced a 3-week sprint with a 2-hour Borchani session. The code quality was good enough to ship straight to production.',
            },
            {
              '@type': 'Review',
              author: { '@type': 'Person', name: 'Daniel K.' },
              reviewBody:
                'Borchani is the first vibe coding tool where the output is actually maintainable TypeScript. Our devs were happy to take it over.',
            },
          ],
        },
      ],
    })}
  />
</PageLayout>
